[
  {
    "info": {
      "_postman_id": "aivacol-fleet-api",
      "name": "Aivacol API — Gestão de Frota",
      "description": "Coleção + environment **Local** embutidos neste arquivo.\n\nPastas: Auth, Users, Brands, Models, Vehicles.\n\n1. Importe só este JSON (cria coleção e environment)\n2. Selecione environment **Aivacol API — Local**\n3. **Auth → POST /auth/login** (salva o token)\n4. Rotas com `:id` — informe o UUID diretamente em cada request",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
      "type": "bearer",
      "bearer": [
        {
          "key": "token",
          "value": "{{accessToken}}",
          "type": "string"
        }
      ]
    },
    "variable": [
      {
        "key": "baseUrl",
        "value": "http://localhost:4000/api/v1"
      },
      {
        "key": "swaggerUrl",
        "value": "http://localhost:4000/api/docs"
      },
      {
        "key": "adminEmail",
        "value": "admin@aivacol.com"
      },
      {
        "key": "adminPassword",
        "value": "Aivacol123!"
      },
      {
        "key": "accessToken",
        "value": ""
      }
    ],
    "item": [
      {
        "name": "Auth",
        "item": [
          {
            "name": "POST /auth/login",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  const body = pm.response.json();",
                    "  pm.environment.set('accessToken', body.accessToken);",
                    "  pm.collectionVariables.set('accessToken', body.accessToken);",
                    "  pm.test('accessToken salvo', () => {",
                    "    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                    "  });",
                    "}"
                  ]
                }
              }
            ],
            "request": {
              "auth": {
                "type": "noauth"
              },
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
              },
              "url": "{{baseUrl}}/auth/login",
              "description": "Autentica com email e senha. Grava `accessToken` no environment."
            }
          },
          {
            "name": "POST /auth/logout",
            "request": {
              "method": "POST",
              "url": "{{baseUrl}}/auth/logout",
              "description": "Encerra sessão no servidor. Descarte o token no cliente após sucesso."
            }
          }
        ],
        "description": "Login é público; logout exige JWT."
      },
      {
        "name": "Users",
        "item": [
          {
            "name": "POST /users",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"nickname\": \"jdoe\",\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@aivacol.com\",\n  \"password\": \"SecurePass@2026\",\n  \"role\": \"operator\"\n}"
              },
              "url": "{{baseUrl}}/users"
            }
          },
          {
            "name": "GET /users",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/users"
            }
          },
          {
            "name": "GET /users/me",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/users/me",
              "description": "Perfil do usuário autenticado (admin ou operator)."
            }
          },
          {
            "name": "GET /users/:id",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/users/:id",
              "description": "Substitua `:id` pelo UUID do usuário."
            }
          },
          {
            "name": "PATCH /users/:id",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"John Doe Updated\"\n}"
              },
              "url": "{{baseUrl}}/users/:id",
              "description": "Substitua `:id` pelo UUID do usuário."
            }
          },
          {
            "name": "DELETE /users/:id",
            "request": {
              "method": "DELETE",
              "url": "{{baseUrl}}/users/:id",
              "description": "Substitua `:id` pelo UUID do usuário. Não é possível remover o próprio usuário autenticado."
            }
          }
        ],
        "description": "Rotas de gestão exigem role **admin** no JWT. `GET /users/me` está disponível para qualquer usuário autenticado."
      },
      {
        "name": "Brands",
        "item": [
          {
            "name": "POST /brands",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Toyota\"\n}"
              },
              "url": "{{baseUrl}}/brands"
            }
          },
          {
            "name": "GET /brands",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/brands"
            }
          },
          {
            "name": "GET /brands/:id",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/brands/:id",
              "description": "Substitua `:id` pelo UUID da marca."
            }
          },
          {
            "name": "PATCH /brands/:id",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Toyota Motor\"\n}"
              },
              "url": "{{baseUrl}}/brands/:id",
              "description": "Substitua `:id` pelo UUID da marca."
            }
          },
          {
            "name": "DELETE /brands/:id",
            "request": {
              "method": "DELETE",
              "url": "{{baseUrl}}/brands/:id",
              "description": "Substitua `:id` pelo UUID da marca."
            }
          }
        ]
      },
      {
        "name": "Models",
        "item": [
          {
            "name": "POST /models",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Corolla\",\n  \"brandId\": \"018f1234-5678-7890-abcd-ef1234567890\"\n}"
              },
              "url": "{{baseUrl}}/models",
              "description": "Substitua `brandId` pelo UUID retornado em POST /brands, ou use POST /models (sem marca)."
            }
          },
          {
            "name": "POST /models (sem marca)",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Modelo Genérico\"\n}"
              },
              "url": "{{baseUrl}}/models"
            }
          },
          {
            "name": "GET /models",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/models"
            }
          },
          {
            "name": "GET /models/:id",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/models/:id",
              "description": "Substitua `:id` pelo UUID do modelo."
            }
          },
          {
            "name": "PATCH /models/:id",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"name\": \"Corolla XEi\"\n}"
              },
              "url": "{{baseUrl}}/models/:id",
              "description": "Substitua `:id` pelo UUID do modelo."
            }
          },
          {
            "name": "PATCH /models/:id (desassociar marca)",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"brandId\": null\n}"
              },
              "url": "{{baseUrl}}/models/:id",
              "description": "Substitua `:id` pelo UUID do modelo."
            }
          },
          {
            "name": "DELETE /models/:id",
            "request": {
              "method": "DELETE",
              "url": "{{baseUrl}}/models/:id",
              "description": "Substitua `:id` pelo UUID do modelo."
            }
          }
        ]
      },
      {
        "name": "Vehicles",
        "item": [
          {
            "name": "POST /vehicles",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"licensePlate\": \"ABC1D23\",\n  \"chassis\": \"9BWZZZ377VT004251\",\n  \"renavam\": \"12345678901\",\n  \"year\": 2024,\n  \"modelId\": \"018f1234-5678-7890-abcd-ef1234567890\"\n}"
              },
              "url": "{{baseUrl}}/vehicles",
              "description": "Substitua `modelId` pelo UUID retornado em POST /models."
            }
          },
          {
            "name": "GET /vehicles",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/vehicles",
              "description": "Primeira chamada popula Redis; repita para observar cache hit."
            }
          },
          {
            "name": "GET /vehicles/:id",
            "request": {
              "method": "GET",
              "url": "{{baseUrl}}/vehicles/:id",
              "description": "Substitua `:id` pelo UUID do veículo."
            }
          },
          {
            "name": "PATCH /vehicles/:id",
            "request": {
              "method": "PATCH",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"year\": 2025\n}"
              },
              "url": "{{baseUrl}}/vehicles/:id",
              "description": "Substitua `:id` pelo UUID do veículo. Invalida entradas de cache de veículos."
            }
          },
          {
            "name": "DELETE /vehicles/:id",
            "request": {
              "method": "DELETE",
              "url": "{{baseUrl}}/vehicles/:id",
              "description": "Substitua `:id` pelo UUID do veículo."
            }
          }
        ],
        "description": "GET list/id usam cache Redis; POST/PATCH/DELETE invalidam o cache."
      }
    ]
  },
  {
    "id": "aivacol-local-env",
    "name": "Aivacol API — Local",
    "values": [
      {
        "key": "baseUrl",
        "value": "http://localhost:4000/api/v1",
        "type": "default",
        "enabled": true
      },
      {
        "key": "swaggerUrl",
        "value": "http://localhost:4000/api/docs",
        "type": "default",
        "enabled": true
      },
      {
        "key": "adminEmail",
        "value": "admin@aivacol.com",
        "type": "default",
        "enabled": true
      },
      {
        "key": "adminPassword",
        "value": "Aivacol123!",
        "type": "secret",
        "enabled": true
      },
      {
        "key": "accessToken",
        "value": "",
        "type": "secret",
        "enabled": true
      }
    ],
    "_postman_variable_scope": "environment"
  }
]
