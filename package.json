{
  "name": "aivacol-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint --write .",
    "start": "yarn validate:env && nest start",
    "start:dev": "yarn validate:env && nest start --watch",
    "start:debug": "yarn validate:env && nest start --debug --watch",
    "start:prod": "node dist/main",
    "validate:env": "ts-node -r tsconfig-paths/register scripts/validate-env.ts",
    "db:create": "ts-node -r tsconfig-paths/register src/database/create-database.ts",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --selectProjects unit --runInBand",
    "test:e2e": "jest --selectProjects e2e",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test:e2e:docker": "yarn test:integration",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "yarn typeorm migration:generate -d src/database/data-source.ts",
    "migration:run": "yarn typeorm migration:run -d src/database/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register ./node_modules/typeorm-extension/bin/cli.mjs seed:run -d src/database/data-source.ts",
    "docker:up": "docker compose -f docker-compose.yml up --build api",
    "docker:down": "docker compose -f docker-compose.yml down"
  },
  "dependencies": {
    "@nestjs/cache-manager": "3.1.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.1",
    "amqplib": "2.0.1",
    "bcryptjs": "3.0.2",
    "cache-manager": "7.2.8",
    "cache-manager-redis-yet": "5.1.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "email-validator": "2.0.4",
    "helmet": "8.2.0",
    "keyv": "5.6.0",
    "mongodb": "7.2.0",
    "mssql": "12.5.5",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "password-validator": "5.3.0",
    "redis": "6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "5.0.1",
    "typeorm": "1.0.0",
    "typeorm-extension": "3.9.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "0.10.8",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
