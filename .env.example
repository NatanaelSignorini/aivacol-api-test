# =============================================================================
# Aivacol API - Environment variables template
# =============================================================================
#
# SETUP:
#   cp .env.example .env
#
# DOCKER (app + infra completa — SQL Server, Redis, RabbitMQ, MongoDB):
#   docker compose up --build
#   Migrations + seed rodam no entrypoint antes da API subir.
#   Use os hostnames dos services abaixo (padrão neste arquivo).
#   UI RabbitMQ: http://localhost:15672 (guest/guest)
#
# DOCKER (só infra) + API no host (yarn start:dev):
#   docker compose up sqlserver redis -d
#   Ajuste no .env: DB_HOST=localhost, REDIS_HOST=localhost
#   RABBITMQ_ENABLED=false, MONGODB_ENABLED=false
#   yarn migration:run && yarn seed
#   yarn start:dev
#
# Testes de integração (SQL Server + Redis reais):
#   docker compose up sqlserver redis -d
#   yarn test:integration
#
# SQL Server com crash ao subir:
#   docker compose down -v && docker compose up --build
#
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# REQUIRED: Must be ≥32 characters
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Database (SQL Server)
# -----------------------------------------------------------------------------
# sqlserver = API no Docker | localhost = API no host (yarn start:dev)
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_DATABASE=aivacol
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------------------------------
# Redis (cache de veículos)
# -----------------------------------------------------------------------------
# redis = API no Docker | localhost = API no host (yarn start:dev)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_TTL=300

# -----------------------------------------------------------------------------
# RabbitMQ (eventos de veículos)
# -----------------------------------------------------------------------------
# false = API no host ou testes. true = exige URL, EXCHANGE e PORT (porta deve bater com a URL).
# rabbitmq = API no Docker | localhost = API no host
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=aivacol.vehicles
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -----------------------------------------------------------------------------
# MongoDB (auditoria de interações)
# -----------------------------------------------------------------------------
# false = API no host ou testes. true = exige URI, DATABASE e PORT (porta deve bater com a URI).
# mongodb = API no Docker | localhost = API no host
MONGODB_ENABLED=true
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=aivacol_audit
MONGODB_PORT=27017

# -----------------------------------------------------------------------------
# Swagger
# -----------------------------------------------------------------------------
SWAGGER_PATH=api/docs
