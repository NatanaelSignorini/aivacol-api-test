# =============================================================================
# Clockin API - Environment variables template
# =============================================================================
#
# SETUP:
#   1. Development: cp .env.example .env
#   2. Tests (integration/e2e): cp .env.example .env.test → override values below
#
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development

# API base path (e.g. /api/v1/health)
API_PREFIX=api/v1

# HTTP port for serverless-offline
PORT=4000

# -----------------------------------------------------------------------------
# Serverless Framework v4
# -----------------------------------------------------------------------------
# OPTIONAL: Only required for "serverless deploy" command
# Development/Test: can be empty or mock value
# Production: Create at: https://app.serverless.com → Settings → Access Keys
SERVERLESS_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# OPTIONAL: Defaults to true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true

# CORS allowed origins (comma-separated). 
# OPTIONAL: Empty = no CORS restrictions
# Development: http://localhost:3000,http://localhost:4000,http://0.0.0.0:4000,http://127.0.0.1:4000
# Tests: can be empty
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://0.0.0.0:4000,http://127.0.0.1:4000

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# REQUIRED: Must be ≥32 characters. NEVER use default in production.
# Tests: use test-jwt-secret-key-for-testing-only-32-chars
JWT_SECRET=your-super-secret-key-change-in-production

# OPTIONAL: Defaults shown below
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# REQUIRED: DB_HOST, DB_USERNAME, DB_PASSWORD, DB_DATABASE
# OPTIONAL: DB_PORT (default: 5432)

# DB_HOST: depende de ONDE a API roda em relação ao Postgres
#   postgres       → API dentro do Docker com Postgres (docker-compose up)
#   localhost      → API no host, Postgres no Docker (yarn dev ou yarn test)
#   postgres_test  → docker-compose.test.yml (já vem configurado, não precisa .env.test)
DB_HOST=postgres

# DB_PORT: OPTIONAL (default: 5432)
#   5432 → dentro do Docker
#   5434 → conectando do host
DB_PORT=5432

# Para migrations do host: DB_PORT=5434
DB_PORT_EXTERNAL=5434

DB_USERNAME=postgres
DB_PASSWORD=postgres

# Database name:
#   - Development: clockin
#   - Tests: clockin_test_db
DB_DATABASE=clockin

