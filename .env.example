# =============================================================================
# Aivacol API - Environment variables template
# =============================================================================
#
# SETUP:
#   cp .env.example .env
#
# DOCKER (app + infra):
#   docker compose up --build
#   O compose sobrescreve DB_HOST=sqlserver e REDIS_HOST=redis no container da API.
#   Mantenha localhost aqui — funciona para ambos os cenários abaixo.
#
# DOCKER (só infra) + app no host:
#   docker compose up sqlserver redis -d
#   yarn start:dev
#   Use localhost (portas publicadas em 127.0.0.1:1433 e 6379).
#
# SQL Server com crash ao subir:
#   docker compose down -v && docker compose up --build
#
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# REQUIRED: Must be ≥32 characters
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Database (SQL Server)
# -----------------------------------------------------------------------------
# localhost = app no host | sqlserver = sobrescrito pelo docker-compose na API
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_DATABASE=aivacol
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# -----------------------------------------------------------------------------
# Redis (cache de veículos)
# -----------------------------------------------------------------------------
# localhost = app no host | redis = sobrescrito pelo docker-compose na API
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL=300

# -----------------------------------------------------------------------------
# Swagger
# -----------------------------------------------------------------------------
SWAGGER_PATH=api/docs
